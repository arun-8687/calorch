{
  "schema_version": "1.0",
  "event_type": "earnings_call",
  "report_header": {
    "title": "EARNINGS PREP PACK",
    "company": "{company_name} ({primary_ticker})",
    "event": "{quarter} Earnings Call",
    "date": "{event_date} | {event_time}"
  },
  "footer": {
    "prepared_by": "Auto-generated by Calendar-Driven Workflow Orchestrator",
    "data_source": "SEC EDGAR + AlphaSense",
    "generated": "{generated_at}"
  },
  "sections": [
    {
      "id": "executive_snapshot",
      "title": "Executive Snapshot",
      "source": "llm",
      "llm_method": "enrich_headline",
      "fallback": ["{primary_ticker} earnings — see data tables above."],
      "prompt_addendum": "Write a concise 3-4 bullet executive snapshot. Cover: revenue/EPS headline, guidance, key segment trends, and one notable surprise. Use numbers and percentages. Max 30 words per bullet."
    },
    {
      "id": "last_quarter",
      "title": "Last Quarter Performance ({last_quarter_label})",
      "source": "data",
      "table_type": "two_col",
      "rows": [
        {"label": "Revenue", "value": "{rev_actual_display}"},
        {"label": "EPS (Diluted)", "value": "{eps_actual_display}"},
        {"label": "Gross Margin", "value": "{gross_margin_display}"},
        {"label": "Operating Margin", "value": "{operating_margin_display}"},
        {"label": "Net Margin", "value": "{net_margin_display}"}
      ]
    },
    {
      "id": "quarterly_trend",
      "title": "5-Quarter Trend",
      "source": "data",
      "table_type": "multi_col",
      "rows_from": "quarterly_trend"
    },
    {
      "id": "cash_flow_capital",
      "title": "Cash Flow & Capital Returns",
      "source": "data",
      "table_type": "multi_col",
      "rows_from": "cash_flow"
    },
    {
      "id": "whats_changed",
      "title": "What Changed This Quarter",
      "source": "llm",
      "llm_method": "enrich_whats_changed",
      "fallback": [],
      "prompt_addendum": "Identify what MATERIALLY CHANGED quarter-over-quarter and year-over-year in the 5-quarter trend and cash-flow data, and why it matters to the investment thesis. Write 3-4 bullets covering: margin inflection, FCF vs net income divergence, working-capital movement, and growth deceleration/acceleration. Each bullet must cite a specific number from the data — do not restate every row."
    },
    {
      "id": "return_ratios",
      "title": "Return Ratios",
      "source": "data",
      "table_type": "two_col",
      "rows": [
        {"label": "ROE", "value": "{roe}"},
        {"label": "ROA", "value": "{roa}"}
      ]
    },
    {
      "id": "balance_sheet",
      "title": "Balance Sheet & Liquidity",
      "source": "data",
      "table_type": "two_col",
      "rows": [
        {"label": "Cash & Equivalents", "value": "{cash}"},
        {"label": "Total Debt", "value": "{total_debt}"},
        {"label": "Net Debt", "value": "{net_debt}"},
        {"label": "Debt/Equity", "value": "{debt_equity}"},
        {"label": "Current Ratio", "value": "{current_ratio}"},
        {"label": "Working Capital", "value": "{working_capital}"}
      ]
    },
    {
      "id": "product_segments",
      "title": "Revenue Segmentation",
      "subtitle": "By Product ({last_quarter_label})",
      "source": "data",
      "table_type": "two_col",
      "rows_from": "segments"
    },
    {
      "id": "geographic_segments",
      "title": "By Geography",
      "source": "data",
      "table_type": "two_col",
      "rows_from": "geo"
    },
    {
      "id": "key_themes",
      "title": "Key Questions & Themes to Monitor",
      "source": "llm",
      "llm_method": "enrich_key_questions",
      "fallback": [],
      "prompt_addendum": "Write 6-8 themed bullet points of key questions and themes to monitor for this earnings call. Each should be a short paragraph (2-3 sentences) covering a specific theme like: demand, margins, guidance, competition, regulatory, new products, capital returns, geopolitical. Format as 'Theme: Question/content...'"
    },
    {
      "id": "guidance_commentary",
      "title": "Guidance & Management Commentary",
      "source": "data",
      "table_type": "multi_col",
      "rows_from": "narrative_docs"
    },
    {
      "id": "filings_search",
      "title": "Recent Filings Mentioning Guidance / Outlook",
      "source": "data",
      "table_type": "multi_col",
      "rows_from": "guidance_filings"
    },
    {
      "id": "sentiment",
      "title": "Sentiment",
      "source": "data",
      "table_type": "two_col",
      "rows_from": "sentiment"
    }
  ]
}
