{
  "schema_version": "1.0",
  "event_type": "channel_check",
  "report_header": {
    "title": "{primary_ticker} — Channel Check Preparation",
    "company": "{company_name}",
    "event": "Channel Check",
    "date": "{event_date} | {event_time}"
  },
  "metadata_table": {
    "table_type": "two_col",
    "rows": [
      {
        "label": "Organizer",
        "value": "{organizer}"
      },
      {
        "label": "Location",
        "value": "{location}"
      },
      {
        "label": "Latest Filing",
        "value": "{latest_filing}"
      }
    ]
  },
  "sections": [
    {
      "id": "revenue_overview",
      "title": "Revenue Overview",
      "source": "llm",
      "llm_method": "enrich_headline",
      "fallback": [
        "{primary_ticker} reported revenue of {rev_actual} for {last_quarter_label} (YoY {rev_yoy})."
      ],
      "prompt_addendum": "Write a 3-4 sentence revenue overview paragraph. Cover: last quarter revenue, YoY growth, and the multi-quarter trend. Be factual with numbers."
    },
    {
      "id": "revenue_by_segment",
      "title": "Revenue by Segment ({last_quarter_label})",
      "source": "data",
      "table_type": "multi_col",
      "rows_from": "segments"
    },
    {
      "id": "revenue_by_geo",
      "title": "Revenue by Geography ({last_quarter_label})",
      "source": "data",
      "table_type": "multi_col",
      "rows_from": "geo"
    },
    {
      "id": "margin_profile",
      "title": "Margin Profile",
      "source": "data",
      "table_type": "multi_col",
      "rows_from": "margin_profile"
    },
    {
      "id": "key_metrics",
      "title": "Key Operating Metrics",
      "source": "data",
      "table_type": "two_col",
      "rows": [
        {
          "label": "DSO (Days Sales Outstanding)",
          "value": "{dso}"
        },
        {
          "label": "DIO (Days Inventory Outstanding)",
          "value": "{dio}"
        },
        {
          "label": "DPO (Days Payables Outstanding)",
          "value": "{dpo}"
        },
        {
          "label": "Cash Conversion Cycle",
          "value": "{ccc}"
        },
        {
          "label": "FCF ({last_quarter_label})",
          "value": "{fcf_q}"
        },
        {
          "label": "FCF (TTM)",
          "value": "{fcf_ttm}"
        },
        {
          "label": "CapEx ({last_quarter_label})",
          "value": "{capex_q}"
        },
        {
          "label": "CapEx (TTM)",
          "value": "{capex_ttm}"
        },
        {
          "label": "R&D ({last_quarter_label})",
          "value": "{rd_display}"
        },
        {
          "label": "Buybacks ({last_quarter_label})",
          "value": "{buyback_q}"
        },
        {
          "label": "Buybacks (TTM)",
          "value": "{buyback_ttm}"
        }
      ],
      "source_note": "Source: SEC company facts (XBRL), latest reported period"
    },
    {
      "id": "metrics_to_validate",
      "title": "Section 2: Key Metrics to Validate",
      "source": "data",
      "table_type": "multi_col",
      "rows_from": "metrics_to_validate"
    },
    {
      "id": "sentiment",
      "title": "Sentiment",
      "source": "data",
      "table_type": "two_col",
      "rows_from": "sentiment"
    },
    {
      "id": "questionnaire",
      "title": "Section 3: Standardized Questionnaire",
      "source": "llm",
      "llm_method": "enrich_channel_check_questions",
      "fallback": [
        {
          "section": "Demand & Volume",
          "questions": [
            {
              "q": "Q1. How would you characterize demand over the past 90 days?",
              "followup": "Any regional differences?",
              "maps_to": "Revenue Volume"
            },
            {
              "q": "Q2. What demand signals are you seeing from key markets?",
              "followup": "Any government procurement shifts?",
              "maps_to": "Geographic Revenue"
            }
          ]
        },
        {
          "section": "Pricing Trends",
          "questions": [
            {
              "q": "Q3. Are you seeing promotional intensity beyond normal patterns?",
              "followup": "Any trade-in program changes?",
              "maps_to": "ASP Trajectory"
            }
          ]
        }
      ],
      "prompt_addendum": "Write a structured channel check questionnaire with 15-20 questions across 5 themes: Demand & Volume, Pricing Trends, Competitive Dynamics, Inventory & Supply Chain, and Forward Outlook. For each question include: the question, a follow-up prompt, and what metric it maps to. Format clearly with section headers."
    },
    {
      "id": "channel_tracking",
      "title": "Channel Finding Tracker",
      "source": "data",
      "table_type": "multi_col",
      "headers": [
        "Model Metric",
        "Our Model",
        "Channel Finding",
        "Variance",
        "Thesis Implication",
        "Conf."
      ],
      "blank_rows": 12
    },
    {
      "id": "contact_log",
      "title": "Contact Log",
      "source": "data",
      "table_type": "multi_col",
      "headers": [
        "Date",
        "Contact / Company",
        "Key Finding",
        "Model Impact",
        "Conf.",
        "Follow-up Questions"
      ],
      "blank_rows": 8
    }
  ]
}
