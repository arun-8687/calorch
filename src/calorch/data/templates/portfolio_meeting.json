{
  "schema_version": "1.0",
  "event_type": "portfolio_meeting",
  "report_header": {
    "title": "WEEKLY PORTFOLIO REVIEW",
    "meeting": "Investment Team Meeting",
    "date": "{event_date} | {event_time}"
  },
  "sections": [
    {
      "id": "watchlist_snapshot",
      "title": "Watchlist Snapshot",
      "source": "data",
      "table_type": "multi_col",
      "rows_from": "watchlist_snapshot"
    },
    {
      "id": "sentiment_overview",
      "title": "Sentiment Overview",
      "source": "data",
      "table_type": "multi_col",
      "rows_from": "sentiment_overview"
    },
    {
      "id": "fundamental_highlights",
      "title": "Fundamental Highlights",
      "source": "llm",
      "llm_method": "enrich_headline",
      "fallback": [],
      "prompt_addendum": "Write 3-5 bullet points on the biggest fundamental movers across the watchlist this period, grounded strictly in the revenue-trend data provided. For each: ticker, growth trajectory, and the likely driver. Be concise."
    },
    {
      "id": "upcoming_catalysts",
      "title": "Upcoming Catalysts",
      "source": "data",
      "table_type": "multi_col",
      "rows_from": "catalysts"
    },
    {
      "id": "discussion_items",
      "title": "Discussion Items & Action Items",
      "source": "llm",
      "llm_method": "enrich_key_questions",
      "fallback": [],
      "prompt_addendum": "Write 4-5 discussion items for a portfolio review meeting. Each should be a short paragraph covering: position sizing, new ideas, risk management, or macro hedging."
    },
    {
      "id": "action_items",
      "title": "Action Items",
      "source": "data",
      "table_type": "multi_col",
      "headers": ["Item", "Owner", "Status", "Due Date"],
      "blank_rows": 5
    }
  ]
}
